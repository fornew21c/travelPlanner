# =============================================================================
# AI Family Travel Planner – Environment Variables
# Copy to .env.local for local development. Set these in Vercel for production.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# --- AI Providers -----------------------------------------------------------
# Which provider to use at runtime. Either "openai" or "anthropic".
AI_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional — only needed if you switch AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI 패밀리 트래블 플래너

# (선택) 호텔 예약 어필리에이트.
# 제공사 선택: booking(기본, 텍스트+날짜 prefill 안정적) 또는 agoda(국내 인기, prefill 약함)
# NEXT_PUBLIC_HOTEL_PROVIDER=booking
# Booking.com 제휴 가입 후 aid → 검색 링크가 수수료 추적 링크로 전환 (없으면 일반 검색)
# NEXT_PUBLIC_BOOKING_AID=
# Agoda Partners 가입 후 cid (NEXT_PUBLIC_HOTEL_PROVIDER=agoda 일 때 사용)
# NEXT_PUBLIC_AGODA_CID=
# (선택) 액티비티/투어·입장권 어필리에이트. Klook 제휴 가입 후 aid를 넣으면
# 일정의 "투어·입장권 예약" 링크가 수수료 추적 링크로 전환. 비워두면 일반 검색.
# NEXT_PUBLIC_KLOOK_AID=
